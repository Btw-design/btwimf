# ── BTW IMF — Apache config (Hostinger) ─────────────────────────────────────

Options -Indexes

# Custom error page
ErrorDocument 404 /404.html

# Protect stored form submissions and internal folders
RewriteEngine On
RewriteRule ^_submissions(/.*)?$ - [F,L]

# Legacy .html → clean folder URLs (root pages moved into folders)
RewriteRule ^about\.html$    /about/    [R=301,L]
RewriteRule ^contact\.html$  /contact/  [R=301,L]
RewriteRule ^careers\.html$  /careers/  [R=301,L]

# Drop .html from any direct request, keep the clean URL canonical
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve the .html file for an extensionless request
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
