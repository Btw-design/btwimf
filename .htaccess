# ── BTW IMF — Apache config ────────────────────────────────────────────────
# Requires: mod_rewrite, mod_headers, mod_deflate, mod_expires and, in the
# vhost, "AllowOverride All" (or at least FileInfo Options Indexes Limit).

Options -Indexes
ErrorDocument 404 /404.html
ErrorDocument 410 /410.html

# Never serve dotfiles, config, samples, logs, JSON data, PHP includes
<FilesMatch "(^\.|\.(sample\.php|log)$|composer\.(json|lock))">
  Require all denied
</FilesMatch>

RewriteEngine On

# Block direct access to server-managed data folders
RewriteRule ^_submissions(/.*)?$        - [F,L]
RewriteRule ^_blog-data(/.*)?$          - [F,L]
RewriteRule ^admin/(config|config\.sample|lib|render)\.php$ - [F,L]

# Retired WordPress blog: only /blog/what-is-zero-depreciation-cover/ and
# /blog/pet-insurance-india/ (and /blog/ itself) exist as real files and are
# served normally. Every other /blog/<slug>/ is permanently gone -> 410.
RewriteCond %{REQUEST_FILENAME}  !-f
RewriteCond %{REQUEST_FILENAME}  !-d
RewriteRule ^blog/.+            -  [G,L]

# Legacy .html → clean folder URLs (root pages moved into folders)
RewriteRule ^about\.html$    /about-us/    [R=301,L]
RewriteRule ^contact\.html$  /contact-us/  [R=301,L]
RewriteRule ^careers\.html$  /careers/     [R=301,L]

# Preserve the old working page URLs after the About/Contact rename
RewriteRule ^about/?$    /about-us/    [R=301,L]
RewriteRule ^contact/?$  /contact-us/  [R=301,L]

# Drop .html from any direct request, keep the clean URL canonical
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve the .html file for an extensionless request
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_mime.c>
  AddType image/x-icon                .ico
  AddType application/manifest+json   .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
